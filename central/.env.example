# Copy this file to .env. Central reads .env from the directory where it starts.
# .env is in .gitignore, so your settings stay on this computer.
# A variable that you set in the shell wins over this file.

# Analytics database. This is the local database from `make db-up`.
MOOCH_DB_URL=postgres://postgres:mooch@127.0.0.1:5432/postgres

# Listen address. 127.0.0.1:8080 is for local tests. Remove the line to listen on the Tailscale IPv4.
MOOCH_ADDR=127.0.0.1:8080
