network:
  # Tailscale IPv4 address of the Mooch.ai central server.
  central_host: "100.64.0.10"
  central_port: 8080

  # Address for routed requests from central.
  listen_host: "0.0.0.0"
  listen_port: 9100

  heartbeat_interval: 15s

node:
  name: "local-ai-node"
  # Leave id empty to generate and persist ~/.config/mooch/node.id.
  id: ""

# Simplified form: name one backend per local server. The node discovers
# models from GET {endpoint}{api_base}/models and builds the broadcast
# services. The broadcast shape sent to central stays unchanged.
backends:
  - name: "local-llm"
    endpoint: "http://127.0.0.1:11434"
    # api_base defaults to /v1. provider enables extras: ollama reads
    # POST /api/show, llamacpp reads GET /props. Empty means generic.
    provider: "ollama"
    # expose defaults to all models. List names to filter down.
    expose: ["*"]
    # model_meta overrides discovery per model. Use it when the backend
    # hides context_window.
    model_meta:
      qwen2.5:
        context_window: 32768

# Legacy form: static services still work. Discovery merges with this list.
# services:
#   - id: "local-llm"
#     name: "Local LLM"
#     type: "llm"
#     provider: "ollama"
#     endpoint: "http://127.0.0.1:11434"
